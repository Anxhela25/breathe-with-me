# Copy this file to ".env" and fill in the values. Never commit .env.
DATABASE_URL=postgresql+psycopg://YOUR_MAC_USER@localhost:5432/breathe_with_me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# capacitor://localhost is the iPhone app
CORS_ORIGINS=["http://localhost:5173","capacitor://localhost"]

# AI chat. A provider without a key is skipped.
GROQ_API_KEY=
GEMINI_API_KEY=

# Sign-up and password reset codes. Gmail is used when both values are set, otherwise Resend (resend.com).
# With neither, emails are only written to the server log, so you can copy the code from there.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# Needs a domain verified in Resend. The default sender only reaches the Resend account owner.
# EMAIL_FROM=Breathe With Me <noreply@yourdomain.com>
